{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/finance/:path*",
      "destination": "/api/finance-rest?__financePath=:path*"
    },
    {
      "source": "/api/property/:path*",
      "destination": "/api/property-rest?__propertyPath=:path*"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/residents",
      "destination": "/residents/index.html"
    },
    {
      "source": "/residents/:path*",
      "destination": "/residents/index.html"
    },
    {
      "source": "/parking",
      "destination": "/parking/index.html"
    },
    {
      "source": "/parking/:path*",
      "destination": "/parking/index.html"
    },
    {
      "source": "/units",
      "destination": "/units/index.html"
    },
    {
      "source": "/units/:path*",
      "destination": "/units/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/home/:path*",
      "destination": "/home/index.html"
    },
    {
      "source": "/new",
      "destination": "/home/index.html"
    },
    {
      "source": "/new/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/new/home/:path*",
      "destination": "/home/index.html"
    },
    {
      "source": "/new/residents",
      "destination": "/residents/index.html"
    },
    {
      "source": "/new/residents/:path*",
      "destination": "/residents/index.html"
    },
    {
      "source": "/new/parking",
      "destination": "/parking/index.html"
    },
    {
      "source": "/new/parking/:path*",
      "destination": "/parking/index.html"
    },
    {
      "source": "/new/units",
      "destination": "/units/index.html"
    },
    {
      "source": "/new/units/:path*",
      "destination": "/units/index.html"
    },
    {
      "source": "/new/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/new/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/new/finance/:path*",
      "destination": "/finance/:path*"
    },
    {
      "source": "/((?!api/|assets/|finance/|residents/|parking/|units/|admin/|home/|new/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/passbook-parse.js": {
      "maxDuration": 300
    },
    "api/sync.js": {
      "maxDuration": 300
    },
    "api/state.js": {
      "maxDuration": 60
    },
    "api/db.js": {
      "maxDuration": 30
    },
    "api/storage.js": {
      "maxDuration": 30
    },
    "api/external-proxy.js": {
      "maxDuration": 30
    },
    "api/rpc.js": {
      "maxDuration": 15
    },
    "api/finance-mutations.js": {
      "maxDuration": 300
    },
    "api/finance-mongo-mutations.js": {
      "maxDuration": 300
    },
    "api/finance/[...path].js": {
      "maxDuration": 300
    },
    "api/finance-rest.js": {
      "maxDuration": 300
    },
    "api/property-rest.js": {
      "maxDuration": 60
    }
  }
}
