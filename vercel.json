{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/auth-session",
      "destination": "/api/auth-rest?__authPath=session"
    },
    {
      "source": "/api/auth-password",
      "destination": "/api/auth-rest?__authPath=password"
    },
    {
      "source": "/api/rbac-mongo",
      "destination": "/api/identity-rest?__identityPath=rbac"
    },
    {
      "source": "/api/dashboard-summary",
      "destination": "/api/identity-rest?__identityPath=dashboard-summary"
    },
    {
      "source": "/api/new/workspace-boot",
      "destination": "/api/identity-rest?__identityPath=workspace-boot"
    },
    {
      "source": "/api/workspace-boot",
      "destination": "/api/identity-rest?__identityPath=workspace-boot"
    },
    {
      "source": "/api/external-connections",
      "destination": "/api/integrations-rest?__integrationsPath=_legacy/external-connections"
    },
    {
      "source": "/api/passbook-jobs",
      "destination": "/api/integrations-rest?__integrationsPath=_legacy/passbook-jobs"
    },
    {
      "source": "/api/passbook-parse",
      "destination": "/api/integrations-rest?__integrationsPath=_legacy/passbook-parse"
    },
    {
      "source": "/api/external-proxy",
      "destination": "/api/integrations-rest?__integrationsPath=_legacy/external-proxy"
    },
    {
      "source": "/api/oauth-microsoft",
      "destination": "/api/integrations-rest?__integrationsPath=_legacy/oauth-microsoft"
    },
    {
      "source": "/api/oauth-service",
      "destination": "/api/integrations-rest?__integrationsPath=_legacy/oauth-service"
    },
    {
      "source": "/api/finance/:path*",
      "destination": "/api/finance-rest?__financePath=:path*"
    },
    {
      "source": "/api/property/:path*",
      "destination": "/api/property-rest?__propertyPath=:path*"
    },
    {
      "source": "/api/integrations/:path*",
      "destination": "/api/integrations-rest?__integrationsPath=:path*"
    },
    {
      "source": "/api/activity/:path*",
      "destination": "/api/activity-rest?__activityPath=:path*"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/",
      "destination": "/home/index.html"
    },
    {
      "source": "/residents",
      "destination": "/residents/index.html"
    },
    {
      "source": "/residents/:path*",
      "destination": "/residents/index.html"
    },
    {
      "source": "/parking",
      "destination": "/parking/index.html"
    },
    {
      "source": "/parking/:path*",
      "destination": "/parking/index.html"
    },
    {
      "source": "/units",
      "destination": "/units/index.html"
    },
    {
      "source": "/units/:path*",
      "destination": "/units/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/home/:path*",
      "destination": "/home/index.html"
    },
    {
      "source": "/new",
      "destination": "/home/index.html"
    },
    {
      "source": "/new/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/new/home/:path*",
      "destination": "/home/index.html"
    },
    {
      "source": "/new/residents",
      "destination": "/residents/index.html"
    },
    {
      "source": "/new/residents/:path*",
      "destination": "/residents/index.html"
    },
    {
      "source": "/new/parking",
      "destination": "/parking/index.html"
    },
    {
      "source": "/new/parking/:path*",
      "destination": "/parking/index.html"
    },
    {
      "source": "/new/units",
      "destination": "/units/index.html"
    },
    {
      "source": "/new/units/:path*",
      "destination": "/units/index.html"
    },
    {
      "source": "/new/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/new/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/new/finance/:path*",
      "destination": "/finance/:path*"
    },
    {
      "source": "/((?!api/|assets/|finance/|residents/|parking/|units/|admin/|home/|new/|login\\.html|microsoft-auth\\.html).*)",
      "destination": "/home/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/finance-rest.js": {
      "maxDuration": 10
    },
    "api/property-rest.js": {
      "maxDuration": 10
    },
    "api/integrations-rest.js": {
      "maxDuration": 10
    },
    "api/activity-rest.js": {
      "maxDuration": 10
    },
    "api/identity-rest.js": {
      "maxDuration": 10
    },
    "api/auth-rest.js": {
      "maxDuration": 10
    },
    "api/storage.js": {
      "maxDuration": 10
    },
    "api/passbook-webhook.js": {
      "maxDuration": 10
    }
  }
}
