# CommunityHub — Caddy site fragment for shared multi-app hosts.
# setup-remote.sh replaces __DOMAIN__ with the real hostname.

__DOMAIN__ {
	encode gzip zstd

	reverse_proxy 127.0.0.1:3000

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/communityhub.log
	}
}
