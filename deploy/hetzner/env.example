# Copy to the VM as /etc/communityhub.env (chmod 640, owner root:communityhub).
# Do NOT commit real secrets. Prefer syncing from local .env.local via deploy script.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# 1 after HTTPS is live. Use 0 only for temporary http://IP smoke tests.
SESSION_COOKIE_SECURE=1

# Auth
AUTH_SESSION_SECRET=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Mongo
MONGODB_URI=
MONGODB_DB_NAME=communityHub

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/opt/communityhub/firebase-service-account.json

# R2 / object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=communityhub

# PUBLIC_BASE_URL=https://communityhub.evolyx.in
