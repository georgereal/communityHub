# Copy to scripts/deploy/hetzner.deploy.env (gitignored) and fill in.
# Used by: npm run deploy:hetzner / npm run bootstrap:hetzner

HETZNER_HOST=your.vm.public.ip.or.hostname
HETZNER_USER=root
HETZNER_PORT=22
# HETZNER_SSH_KEY=~/.ssh/id_ed25519_hetzner

HETZNER_APP_DIR=/opt/communityhub

# Optional: sync secrets each deploy
# HETZNER_SYNC_ENV=1
# HETZNER_ENV_LOCAL=.env.local
# HETZNER_SYNC_FIREBASE_SA=1
# HETZNER_FIREBASE_SA_LOCAL=./firebase-service-account.json

# HETZNER_SKIP_BUILD=1
