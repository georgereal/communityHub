# ─── Session secret (required for email/password login) ───────────────────────
# Signs Mongo session JWTs (POST /api/auth-password). Use a long random string.
AUTH_SESSION_SECRET=

# ─── Firebase Auth (required for social login only) ───────────────────────────
# Console: https://console.firebase.google.com → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Server Admin SDK (pick ONE — do not paste multiline JSON into .env)
FIREBASE_PROJECT_ID=
# Preferred locally: path to the downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Or a single-line JSON string (required on Vercel):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Social buttons on /login (comma list). Default: google,github
# VITE_SOCIAL_AUTH_PROVIDERS=google,github

# ─── Mongo (New app data + email/password credentials) ────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=

# ─── Optional: Classic Postgres / storage / migrations only ──────────────────
# Not required for New-app auth.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
